# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub!
# =============================================

# PostgreSQL — change YOUR_PASSWORD to your actual postgres password
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/career_chatbot

# Google Gemini — get your key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=[GCP_API_KEY]

# App
APP_NAME=AI Career Counseling Chatbot
DEBUG=True
